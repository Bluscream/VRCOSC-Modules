<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latestmajor</LangVersion>
    <!-- Three-target build, one per VRCOSC install. Select with -p:VrcoscTarget=<t>:
         (update.sh wraps this; see its beta and dev flags)

           stable  VRCOSC          app 2026.708.0   SDK 2026.501.0   nuget.org
           beta    VRCOSC-BETA     app 2026.906.0   SDK 2026.906.0   nuget.org
           dev     VRCOSC-DEV      app upstream dev SDK 2026.718.0   local feed

         The three are NOT interchangeable: a DLL only loads on the line it was compiled
         against, otherwise VRCOSC throws TypeLoadException at package import and ends up
         with zero modules.

         stable uses the old concrete node API (ModuleNode<T>, FlowContinuation,
         FlowCall, NodeGenericTypeFilter). beta and dev both use the newer interface API
         (IModuleNode<T>, FlowOutput, IPulseContext) and are near-identical - they differ
         by ~6 SDK files, mostly PiShock - so they share the BETA_SDK code path and only
         the SDK version differs. DEV_SDK is defined as well for the rare case something
         needs to split them. See GlobalUsings.cs.

         Upstream publishes the SDK to nuget.org again as of 2026.906.0, so beta no
         longer needs the local feed. 2026.718.0 (origin/dev @ 9e2a774a) is still packed
         locally into ../local-nuget-feed - see nuget.config for the repack command.

         Never let the SDK version be date-derived. VRCOSC's Directory.Build.props stamps
         GlobalVersion from DateTime.Now, so packing two different branches on the same
         day produces the same version number and NuGet silently serves whichever it
         cached first. That is exactly how the old 2026.729.0 pin ended up built against
         the feat/cli fork rather than upstream, which went unnoticed because it still
         compiled clean. Always pass -p:GlobalVersion explicitly when packing. -->
    <VrcoscTarget Condition="'$(VrcoscTarget)' == ''">stable</VrcoscTarget>
    <!-- back-compat: -p:BetaSdk=true still selects the beta target -->
    <VrcoscTarget Condition="'$(BetaSdk)' == 'true'">beta</VrcoscTarget>

    <VrcoscSdkVersion Condition="'$(VrcoscTarget)' == 'stable'">2026.501.0</VrcoscSdkVersion>
    <VrcoscSdkVersion Condition="'$(VrcoscTarget)' == 'beta'">2026.906.0</VrcoscSdkVersion>
    <VrcoscSdkVersion Condition="'$(VrcoscTarget)' == 'dev'">2026.920.0</VrcoscSdkVersion>

    <DefineConstants Condition="'$(VrcoscTarget)' != 'stable'">$(DefineConstants);BETA_SDK</DefineConstants>
    <DefineConstants Condition="'$(VrcoscTarget)' == 'dev'">$(DefineConstants);DEV_SDK</DefineConstants>

    <WindowsSdkPackageVersion Condition="'$(VrcoscTarget)' == 'stable'">10.0.26100.1</WindowsSdkPackageVersion>
    <WindowsSdkPackageVersion Condition="'$(VrcoscTarget)' != 'stable'">10.0.26100.56</WindowsSdkPackageVersion>
    <SupportedOSPlatform>windows10.0.22621.0</SupportedOSPlatform>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HADotNet.Core" Version="1.6.0" />
    <!--
      MCP protocol layer + cross-platform HTTP server.
      ModelContextProtocol.Core (not .AspNetCore) on purpose: the AspNetCore package
      carries a FrameworkReference on Microsoft.AspNetCore.App, which is NOT installed
      in the Wine/Proton dotnet runtime VRCOSC runs under. Core has no framework
      reference and still ships StreamableHttpServerTransport.
      EmbedIO is used in HttpListenerMode.EmbedIO — its own socket-based listener —
      because System.Net.HttpListener needs http.sys, which Wine stubs out.
    -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.0.0" />
    <PackageReference Include="EmbedIO" Version="3.5.2" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="VolcanicArts.VRCOSC.SDK" Version="$(VrcoscSdkVersion)" />
    <PackageReference Include="Costura.Fody" Version="6.1.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="IrcDotNet" Version="0.7.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--PackageReference Include="PresentMonFps" Version="2.0.6" /-->
    <PackageReference Include="Silk.NET.OpenXR" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenXR.Extensions.EXT" Version="2.22.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude deprecated HTTP module from compilation -->
    <Compile Remove="HTTP\**\*.cs" />
    <Compile Remove="DesktopFPS\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="HTTPServer\openapi.json" LogicalName="Bluscream.Modules.HTTPServer.openapi.json" />
    <EmbeddedResource Include="HTTPServer\swagger-ui.html" LogicalName="Bluscream.Modules.HTTPServer.swagger-ui.html" />
    <EmbeddedResource Include="LinuxMedia\vrcosc_mpris_query.sh" LogicalName="Bluscream.Modules.LinuxMedia.vrcosc_mpris_query.sh" />
    <EmbeddedResource Include="LinuxHardwareStats\vrcosc_hwstats.sh" LogicalName="Bluscream.Modules.LinuxHardwareStats.vrcosc_hwstats.sh" />
    <EmbeddedResource Include="LinuxAudioFx\vrcosc_audiofx.sh" LogicalName="Bluscream.Modules.LinuxAudioFx.vrcosc_audiofx.sh" />
    <EmbeddedResource Include="OpenXR\openxr_loader.dll" LogicalName="Bluscream.Modules.OpenXR.openxr_loader.dll" />
    <EmbeddedResource Include="OpenXR\vrcosc_xr_query.sh" LogicalName="Bluscream.Modules.OpenXR.vrcosc_xr_query.sh" />
  </ItemGroup>
  <!--
    No post-build deploy step here on purpose. Deployment is owned by update.sh,
    which builds Release and copies to packages/remote/bluscream.vrcosc.modules
    (NOT packages/local — VRCOSC would load the module twice).
  -->

  <ItemGroup>
    <Page Update="Status\UI\StatusListModuleSettingView.xaml">
      <Generator>MSBuild:Compile</Generator>
      <XamlRuntime>Wpf</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="HomeAssistant\UI\ParameterRedirectListModuleSettingView.xaml">
      <Generator>MSBuild:Compile</Generator>
      <XamlRuntime>Wpf</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

</Project>
