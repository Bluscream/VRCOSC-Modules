<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Locally-packed VRCOSC SDKs for the dev module target. Upstream stopped publishing
         to nuget.org after 2026.501.0 and resumed with 2026.906.0, so stable and beta both
         come from nuget.org again; anything in between, and dev, is packed from the
         source-code/ worktrees. Kept inside the project (not /tmp) so it survives
         reboots - an earlier /tmp feed was garbage collected, leaving behind a pin that
         could not be explained or reproduced.

         Regenerate with ./tools/pack-sdks.sh, which resolves the beta commit from the latest
         GitHub pre-release and always forces GlobalVersion (it is otherwise derived from
         today's date, which silently collides across branches). -->
    <add key="local-vrcosc-sdk" value="../local-nuget-feed" />
  </packageSources>
</configuration>
